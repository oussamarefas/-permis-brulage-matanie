(async function geocoderPermisHistoriquesAmeliore(){

    const FICHIER = "./permis-historiques.json?t=" + Date.now();
    const CACHE_KEY = "cache_geocode_permis_historiques_v4";

    function pause(ms){
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function lireCache(){
        try {
            return JSON.parse(localStorage.getItem(CACHE_KEY) || "{}");
        } catch(e) {
            return {};
        }
    }

    function sauverCache(cache){
        localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    }

    function normaliserTexte(valeur){
        return String(valeur || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/\s+/g, " ")
            .trim();
    }

    function nettoyerVille(ville){

        const v = normaliserTexte(ville);

        const correspondances = {
            "matane": "Matane",
            "les mechins": "Les Méchins",
            "grosses-roches": "Grosses-Roches",
            "sainte-felicite": "Sainte-Félicité",
            "saint-adelme": "Saint-Adelme",
            "saint-rene-de-matane": "Saint-René-de-Matane",
            "baie-des-sables": "Baie-des-Sables",
            "saint-jean-de-cherbourg": "Saint-Jean-de-Cherbourg",
            "sainte-paule": "Sainte-Paule",
            "saint-leandre": "Saint-Léandre",
            "saint-ulric": "Saint-Ulric"
        };

        return correspondances[v] || ville || "";
    }

    function nettoyerAdresse(adresse){

        return String(adresse || "")
            .replace(/\s+/g, " ")
            .replace(/\s+,/g, ",")
            .replace(/,\s*,/g, ",")
            .replace(/\bGOJ\b/gi, "G0J")
            .replace(/\bRTE\b/gi, "route")
            .replace(/\brte\b/gi, "route")
            .replace(/\bRT\b/gi, "route")
            .replace(/\bav\.\b/gi, "avenue")
            .replace(/\bSt-René\b/gi, "Saint-René")
            .replace(/\bSt-Jean\b/gi, "Saint-Jean")
            .replace(/\bSte-Félicité\b/gi, "Sainte-Félicité")
            .replace(/\bSte-Paule\b/gi, "Sainte-Paule")
            .replace(/,\s*Québec,\s*Canada,\s*Québec,\s*Canada/gi, ", Québec, Canada")
            .replace(/,\s*Canada,\s*Québec,\s*Canada/gi, ", Québec, Canada")
            .replace(/,\s*QC,\s*Québec,\s*Canada/gi, ", Québec, Canada")
            .trim();
    }

    function extraireNumeroCivique(adresse){
        const m = String(adresse || "").trim().match(/^(\d+[A-Za-z]?(-\d+)?)/);
        return m ? m[1] : "";
    }

    function retirerCodePostal(adresse){
        return String(adresse || "")
            .replace(/\b[A-Z]\d[A-Z]\s?\d[A-Z]\d\b/gi, "")
            .replace(/\s+/g, " ")
            .trim();
    }

    function construireAdresseComplete(p){

        let adresse = nettoyerAdresse(p.adresseComplete || "");
        let ville = nettoyerVille(p.ville || p.Data?.CityName || "");

        if(!adresse){
            return "";
        }

        if(ville && !normaliserTexte(adresse).includes(normaliserTexte(ville))){
            adresse = adresse.replace(/,\s*Québec,\s*Canada/gi, "");
            adresse = `${adresse}, ${ville}, Québec, Canada`;
        }

        if(!/québec/i.test(adresse)){
            adresse = `${adresse}, Québec, Canada`;
        }

        if(!/canada/i.test(adresse)){
            adresse = `${adresse}, Canada`;
        }

        return nettoyerAdresse(adresse);
    }

    function variantesAdresse(p){

        const adresseComplete = construireAdresseComplete(p);
        const ville = nettoyerVille(p.ville || p.Data?.CityName || "");
        const cp = p.codePostal || p.Data?.PostalCode || "";

        const variantes = [];

        if(adresseComplete){
            variantes.push(adresseComplete);
        }

        const sansCP = retirerCodePostal(adresseComplete);
        if(sansCP && sansCP !== adresseComplete){
            variantes.push(sansCP);
        }

        // Variante plus courte : adresse + ville + province.
        if(adresseComplete){
            const courte = adresseComplete
                .replace(/,\s*Québec,\s*Canada/gi, "")
                .replace(/,\s*Canada/gi, "")
                .trim();

            variantes.push(`${courte}, Québec, Canada`);
        }

        // Variante structurée quand un numéro civique existe.
        const numero = extraireNumeroCivique(adresseComplete);

        if(numero && ville){
            const rueSansVille = adresseComplete
                .replace(/,\s*Québec,\s*Canada/gi, "")
                .replace(new RegExp(",\\s*" + ville.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i"), "")
                .trim();

            variantes.push(`${rueSansVille}, ${ville}, QC, Canada`);
        }

        // Retirer doublons.
        return [...new Set(
            variantes
                .map(a => nettoyerAdresse(a))
                .filter(Boolean)
        )];
    }

    function coordonneesDansMatanie(lat, lon){

        const latitude = parseFloat(lat);
        const longitude = parseFloat(lon);

        if(isNaN(latitude) || isNaN(longitude)){
            return false;
        }

        // Bornes larges pour éviter les résultats ailleurs au Québec/Canada.
        return (
            latitude >= 48.30 &&
            latitude <= 49.35 &&
            longitude >= -68.50 &&
            longitude <= -66.40
        );
    }

    async function geocoderAdresse(adresse, cache){

        const cle = normaliserTexte(adresse);

        if(cache[cle]){
            return cache[cle];
        }

        const url =
            "https://nominatim.openstreetmap.org/search" +
            "?format=json" +
            "&limit=3" +
            "&countrycodes=ca" +
            "&q=" + encodeURIComponent(adresse);

        try {

            const r = await fetch(url, {
                headers: {
                    "Accept": "application/json"
                }
            });

            const data = await r.json();

            if(Array.isArray(data) && data.length > 0){

                for(const resultat of data){

                    if(coordonneesDansMatanie(resultat.lat, resultat.lon)){

                        const coords = {
                            latitude: resultat.lat,
                            longitude: resultat.lon,
                            display_name: resultat.display_name
                        };

                        cache[cle] = coords;
                        sauverCache(cache);

                        return coords;
                    }
                }
            }

        } catch(e) {
            console.warn("Erreur de géocodage :", adresse, e);
        }

        return null;
    }

    function telechargerJson(nomFichier, data){

        const blob = new Blob(
            [JSON.stringify(data, null, 2)],
            {
                type: "application/json"
            }
        );

        const url = URL.createObjectURL(blob);

        const a = document.createElement("a");
        a.href = url;
        a.download = nomFichier;

        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        URL.revokeObjectURL(url);
    }

    function telechargerCSV(nomFichier, lignes){

        if(!lignes.length){
            return;
        }

        const entetes = Object.keys(lignes[0]);

        const contenu = [
            entetes.join(";"),
            ...lignes.map(ligne =>
                entetes.map(cle =>
                    `"${String(ligne[cle] ?? "").replace(/"/g, '""')}"`
                ).join(";")
            )
        ].join("\n");

        const blob = new Blob(
            [contenu],
            {
                type: "text/csv;charset=utf-8"
            }
        );

        const url = URL.createObjectURL(blob);

        const a = document.createElement("a");
        a.href = url;
        a.download = nomFichier;

        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        URL.revokeObjectURL(url);
    }

    const reponse = await fetch(FICHIER);

    if(!reponse.ok){
        alert("Impossible de lire permis-historiques.json. Vérifie que le fichier est dans le même dossier que index.html.");
        return;
    }

    const permis = await reponse.json();

    const cache = lireCache();

    const manquants = permis.filter(p => !p.latitude || !p.longitude);

    if(!confirm(
        "Coordonnées manquantes : " + manquants.length + "\n\n" +
        "Le traitement va nettoyer les adresses et essayer plusieurs variantes.\n" +
        "Cela peut prendre plusieurs minutes.\n\n" +
        "Continuer ?"
    )){
        return;
    }

    let deja = 0;
    let ajoutes = 0;
    let echecs = 0;

    const echecsListe = [];

    for(const p of permis){

        if(p.latitude && p.longitude){
            deja++;
            continue;
        }

        let coords = null;

        const variantes = variantesAdresse(p);

        for(const adresse of variantes){

            console.log("Géocodage :", p.RecordID, adresse);

            coords = await geocoderAdresse(adresse, cache);

            await pause(1200);

            if(coords){
                break;
            }
        }

        if(coords){

            p.latitude = coords.latitude;
            p.longitude = coords.longitude;

            p.Data = p.Data || {};
            p.Data.GeocodeSource = "Nominatim";
            p.Data.GeocodeDisplayName = coords.display_name || "";
            p.Data.GeocodeDate = new Date().toISOString().slice(0, 10);

            ajoutes++;

            console.log(
                "Coordonnées ajoutées :",
                p.RecordID,
                p.latitude,
                p.longitude
            );

        } else {

            echecs++;

            echecsListe.push({
                RecordID: p.RecordID,
                adresseComplete: p.adresseComplete,
                ville: p.ville || p.Data?.CityName || "",
                StartDate: p.Data?.StartDate || "",
                EndDate: p.Data?.EndDate || ""
            });

            console.warn(
                "Coordonnées introuvables :",
                p.RecordID,
                p.adresseComplete
            );
        }
    }

    telechargerJson("permis-historiques.json", permis);
    telechargerCSV("echecs-geocodage.csv", echecsListe);

    console.table(echecsListe);

    alert(
        "Géocodage terminé.\n\n" +
        "Déjà avec coordonnées : " + deja + "\n" +
        "Coordonnées ajoutées : " + ajoutes + "\n" +
        "Échecs : " + echecs + "\n\n" +
        "Deux fichiers peuvent avoir été téléchargés :\n" +
        "- permis-historiques.json\n" +
        "- echecs-geocodage.csv"
    );

})();
